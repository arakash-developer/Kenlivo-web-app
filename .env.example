# ---- Public (exposed to the browser) ----
# Same-origin API — no external server needed.
NEXT_PUBLIC_API_URL=/api/v1

# ---- Better Auth (server-side) ----
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5170

# ---- MongoDB ----
MONGODB_URI=
DB_NAME=kenlivo

# ---- JWT secrets (generate with: openssl rand -base64 32) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
